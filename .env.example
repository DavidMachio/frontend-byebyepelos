# Copia este archivo a .env.local (ese archivo no se sube a GitHub) y ajusta el valor.
# Después reinicia "npm run dev": Vite solo lee las variables al arrancar.
#
# URL del backend. Si no defines nada, la web usa el backend de producción.
# Para probar el backend en tu ordenador, usa la segunda línea en lugar de la primera.
# Las variables VITE_ quedan visibles en el navegador: no pongas aquí secretos.
VITE_API_URL=https://backend-byebyepelos.vercel.app/api/v1
# VITE_API_URL=http://localhost:3000/api/v1
